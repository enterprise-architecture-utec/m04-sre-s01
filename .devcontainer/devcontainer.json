{
  "name": "UTEC SRE - AWS Observability Lab",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "onCreateCommand": "bash .devcontainer/install-aws-cli.sh",
  "postCreateCommand": "aws --version && python --version && zip -v | head -n 2",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "amazonwebservices.aws-toolkit-vscode"
      ]
    }
  },
  "remoteUser": "vscode"
}
